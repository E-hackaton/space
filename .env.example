# Modèle de configuration de production. Copier en .env et remplir (ne jamais committer .env).

# Domaine public : Caddy obtient automatiquement le certificat HTTPS pour ce domaine.
DOMAIN=space.techledger.io

# Django
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=space.techledger.io
DJANGO_CSRF_TRUSTED_ORIGINS=https://space.techledger.io
