# Caddy : HTTPS automatique pour le domaine, puis répartition des requêtes.
# Le domaine vient de la variable d'environnement DOMAIN (fichier .env).
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API REST et administration : Django (gunicorn).
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /admin* {
		reverse_proxy backend:8000
	}

	# Fichiers statiques de l'admin (collectstatic) et images téléversées.
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# Application React. Les fichiers de /assets ont un nom unique (hash) : cache d'un an.
	handle {
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		root * /srv/app
		# Toute autre route renvoie index.html : c'est React Router qui affiche la bonne page.
		try_files {path} /index.html
		file_server
	}
}
